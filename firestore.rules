rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== QUIÉN PUEDE USAR LA PÁGINA ======
    // Opción 1: lista de mails (agregá o sacá personas acá y volvé a publicar las reglas).
    // Opción 2: todo un dominio de mail corporativo (descomentá y cambiá el dominio).
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email in [
            'sschvartz@bistrosa.com.ar',
            'azapatier@bistrosa.com.ar','mbunge@delidips.com.ar', 'vmeyer@bistrosa.com.ar', 'fpampuro@delidips.com.ar', 'agdemirdjian@kronsa.com.ar'
          ]
          // || request.auth.token.email.matches('.*@delidips[.]com[.]ar$')
        );
    }

    match /{document=**} {
      allow read, write: if permitido();
    }
  }
}
